# Copy to /etc/postgres-backup.env on postgres.ad.gavinf.com, fill in, then:
#   sudo chown root:root /etc/postgres-backup.env && sudo chmod 600 /etc/postgres-backup.env
# Never commit the real one.

R2_BUCKET=postgres-backups

# rclone reads its "r2" remote from these, so there's no rclone.conf to manage.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=<from the R2 API token>
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=<from the R2 API token>
# The token can only touch objects in this bucket, so don't let rclone try to check or create it.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
