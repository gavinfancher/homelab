# Copy to /etc/postgres-backup.env on postgres.ad.gavinf.com and fill in. Root only:
#   sudo chown root:root /etc/postgres-backup.env && sudo chmod 600 /etc/postgres-backup.env
# Never commit the real one.
#
# Just the Infisical machine identity's login. The R2 keys themselves stay in Infisical.

INFISICAL_CLIENT_ID=<postgres-backup identity, universal auth client id>
INFISICAL_CLIENT_SECRET=<its client secret>
# homelab-postgres. Not a secret: useless without the identity's login above.
INFISICAL_PROJECT_ID=68a41a02-3fc1-4678-af69-c2ddc76c9ff7
